roup Autoselfie"},"chat.group_autoselfie.auto_selfie_sheet_v2_auto_selfie_2":{"text":"Group Autoselfie"},"chat.group_autoselfie_participants":{"text":"Group autoselfie participants"},"chat.group_autoselfie_requested":{"text":"Group autoselfie requested"},"chat.group_chat_with_value":{"text":"Group chat with {{name}}"},"chat.group_context.group_settings_sheet_v2_group_se":{"text":"Group Context"},"chat.group_context.lib_lib_label_text":{"text":"Group Context"},"chat.group_conversation":{"text":"Group conversation"},"chat.group_deleted":{"text":"Group deleted"},"chat.group_directive.group_settings_sheet_v2_group_se":{"text":"Group Directive"},"chat.group_directive.lib_lib_label_text":{"text":"Group Directive"},"chat.group_directive_optional":{"text":"Group directive (optional)"},"chat.group_members":{"text":"Group members"},"chat.group_name":{"text":"Group Name"},"chat.group_selfie_credit_cost":{"text":"{{count}} credits","plural":{"one":"{{count}} credit","other":"{{count}} credits"},"countPlaceholder":"count"},"chat.group_selfie_requested":{"text":"Group selfie requested"},"chat.group_settings.group_settings_sheet_v2_group_se":{"text":"Group settings"},"chat.group_settings.group_settings_sheet_v2_group_se_2":{"text":"Group settings"},"chat.group_settings_saved":{"text":"Group settings saved"},"chat.groups_can_have_up_to_value_kindroids":{"text":"Groups can have up to {{MAX_GROUP_AIS}} Kindroids."},"chat.growth_relationship":{"text":"Growth & relationship"},"chat.h_432cb7":{"text":"{{value1}}h"},"chat.hey_i_was_just_thinking_about_that_thing_you_said_last_":{"text":"hey - i was just thinking about that thing you said last week. it stuck with me."},"chat.hide_background":{"text":"Hide Background"},"chat.hide_keyboard":{"text":"Hide keyboard"},"chat.high_low_contrast":{"text":"High → low contrast"},"chat.higher_values_increase_likeness_but_can_reduce_image_qu":{"text":"Higher values increase likeness, but can reduce image quality."},"chat.history":{"text":"History"},"chat.horizontal_alignment":{"text":"Horizontal alignment"},"chat.hour_by_hour_details.audio_credits_pane_v2_audio_cred":{"text":"Hour by hour details"},"chat.hour_by_hour_details.audio_credits_pane_v2_audio_cred_2":{"text":"Hour by hour details"},"chat.how_audio_credits_work.audio_credits_pane_v2_audio_cred":{"text":"How audio credits work"},"chat.how_audio_credits_work.audio_credits_pane_v2_audio_cred_2":{"text":"How audio credits work"},"chat.how_do_the_kins_know_each_other":{"text":"How do the kins know each other?"},"chat.how_far_back":{"text":"How far back?"},"chat.how_many_messages_to_rewind":{"text":"How many messages to rewind"},"chat.how_s_kindroid_been_so_far":{"text":"How\'s Kindroid been so far?"},"chat.how_should_the_kin_move_camera_framing_gesture_expressi":{"text":"How should the kin move? Camera framing, gesture, expression..."},"chat.how_the_group_should_behave_on_a_call_pacing_tone_who_l":{"text":"How the group should behave on a call - pacing, tone, who leads."},"chat.how_the_group_should_behave_tone_pacing_conversational_":{"text":"How the group should behave - tone, pacing, conversational style."},"chat.how_your_kindroid_has_changed_and_how_your_relationship":{"text":"How your Kindroid has changed and how your relationship has developed."},"chat.https_www_kindroid_com":{"text":"https://www.kindroid.com"},"chat.important_facts":{"text":"Important facts"},"chat.include_kins":{"text":"Include Kins"},"chat.incoming_voice_call_recap":{"text":"Incoming voice call recap"},"chat.info_00a96e474a11":{"text":"Solo is your kin alone. Couple puts your user avatar in the shot with them, so it needs an avatar with an appearance description."},"chat.info_018307a74cb3":{"text":"Available when the message includes text."},"chat.info_047eb7badd78":{"text":"Describe what the kin should be doing — the setting, mood, outfit and lighting. This sets the overall composition of the photo."},"chat.info_061b4d63b1d7":{"text":"Available on the latest editable user message."},"chat.info_0d727afbc06d":{"text":"Allow Kindroids to access recent messages between this group and their individual chats while keeping the current chat context the priority."},"chat.info_105ed3794ed1":{"text":"Let this group\'s conversations update Learned Context for participating Kindroids. Each Kindroid\'s own Learned Context must also be enabled for them to get updates."},"chat.info_1353b472d4b9":{"text":"Available on messages that can start a new scenario."},"chat.info_15514000560e":{"text":"Automatic lets the AI determine who speaks based on context or @name mentions. Manual lets you control turns one by one."},"chat.info_1c21513b7042":{"text":"Available at the conversation tail."},"chat.info_20dbd964279d":{"text":"How closely the generation follows the pose reference. Higher values reproduce the arrangement more literally at the cost of prompt accuracy."},"chat.info_27387836b4cc":{"text":"Rewrites the kin\'s reply directly. Use Suggest instead to have the kin revise it in its own words."},"chat.info_29f42eec51d0":{"text":"How many messages to remove, counting back from the one you rewound from."},"chat.info_2c3c38d82e21":{"text":"Use the context to provide backstory and context on how the Kindroids should relate to each other. Limits with add-ons: Base 1000 characters, Ultra 1500, MAX 3000."},"chat.info_3025502b4068":{"text":"Tone and behavior guidance specific to voice calls - separate from the chat-side Response Directive."},"chat.info_30a7137405c4":{"text":"A strong suggestion for all Kindroids, such as \\"be concise\\" or \\"speak in third person.\\" This is added alongside each Kindroid\'s own directive."},"chat.info_3afe8f07412a":{"text":"Available on Kin responses that support learned context."},"chat.info_3f34629fbba8":{"text":"Available only for V2 voices. Generates replies faster at the cost of a small amount of expressiveness."},"chat.info_3fc82e2b6b1c":{"text":"The generation model used for the selfie. It is picked automatically from the participants unless you override it."},"chat.info_42c465d22323":{"text":"An optional photo whose pose and composition guide the generated selfie — the kin is re-rendered into a similar arrangement."},"chat.info_4626619d7a20":{"text":"Let this group form long-term memories for participating Kindroids."},"chat.info_462daf0d7af0":{"text":"How the kin should respond - tone, length, style. Tightens the kin\'s voice across every reply."},"chat.info_4fe8eedea23a":{"text":"An optional photo whose pose and composition guide the generated selfie — the kins are re-rendered into a similar arrangement."},"chat.info_552cdffed7fa":{"text":"The aspect ratio of the generated video. 1:1 is square, 2:3 is portrait, 3:2 is landscape."},"chat.info_5a4c3df35cb8":{"text":"NSFW engine optimizes anatomy in NSFW prompts but may generate different visual styles with potentially lower overall image quality."},"chat.info_6274a4bf2850":{"text":"You\'re granted only the difference between tiers — for example, Standard → Ultra adds the 1.5M credit gap, not a full Ultra allocation as you\'ve already received 1M from Standard."},"chat.info_6627372242a6":{"text":"Rewrites what you said. The kin\'s replies below it stay as they are — this does not regenerate the conversation."},"chat.info_695181096b59":{"text":"Things the kin should always remember about you and your relationship. Pinned to context on every turn."},"chat.info_6b294cf324b0":{"text":"A sample message in the kin\'s voice - calibrates the model\'s sense of their style and rhythm."},"chat.info_6df28c7b2637":{"text":"Subscription audio credits refresh on the 1st of each month, regardless of when you subscribed. Credits from subscription top up to the maximum as outlined in Billing, while paid credits never expire nor top up automatically."},"chat.info_745d4afe1c22":{"text":"When on, the kin chimes in unprompted after a brief pause instead of strictly waiting for your turn."},"chat.info_7507980425c8":{"text":"Rewrites the prompt for more natural variation, so repeated generations differ more."},"chat.info_769c8dc642d5":{"text":"Available when the Autoselfie includes a caption."},"chat.info_78112edb8792":{"text":"Which model renders this image. This choice applies only to this selfie; change the default model in Kin settings."},"chat.info_7baa0c690849":{"text":"Allow explicit content in autoselfie prompts. Off by default."},"chat.info_7d13753902f1":{"text":"Clears the call\'s short-term context. The kin still remembers everything, just resets the active conversation."},"chat.info_8319c4004519":{"text":"Which model generates this video. This choice applies only to this video selfie; change the default model in Kin settings."},"chat.info_8493b2ebfb40":{"text":"Version is automatically determined based on selected participants. You can manually override it here.\\n\\nFor best results, make sure the avatar settings for each participant work with the version you select."},"chat.info_863866503503":{"text":"Pick 2–3 kins to feature in the photo. Their left-to-right order in the carousel is how they’ll be framed in the generated selfie — use the arrows to rearrange."},"chat.info_8ec0b3f940f9":{"text":"Extra context layered on backstory for even more expansive detail. Requires an Ultra or MAX add-on to take effect."},"chat.info_8f9389268e30":{"text":"If you\'ve already received this month\'s credits (or the upgrade difference), cancelling and resubscribing — or recovering from a lapse — will not grant them a second time. Your next allocation arrives on the 1st."},"chat.info_90d4abded197":{"text":"The messages that will be deleted, newest first. Rewinding cannot be undone."},"chat.info_955f63785726":{"text":"Whether the kin recalls your text-chat history during calls. Off keeps voice and chat contexts separate."},"chat.info_9658a0e2a3c1":{"text":"Available when the message includes text to voice."},"chat.info_96eda82c8bbc":{"text":"How strongly the style reference influences the result. Higher values follow its look more closely at the cost of prompt accuracy."},"chat.info_9df36847357f":{"text":"The opening message your Kindroid sends after the break. Leave it as it is to use the default."},"chat.info_a1393cecda7f":{"text":"Available on captioned proactive Autoselfies."},"chat.info_a3da461e66e2":{"text":"Apply a saved avatar before requesting this selfie. This switches the Kindroid\'s active avatar everywhere, not only for this selfie."},"chat.info_a4dbc765cb51":{"text":"Available when the Autoselfie is the latest Kin response."},"chat.info_a5aca82d7ad1":{"text":"Available on proactive Autoselfies."},"chat.info_a873673f2e70":{"text":"New autoselfies will be posted in this conversation. Turning this off won\'t hide autoselfies already in chat. Autoselfies are saved to the gallery either way."},"chat.info_aa73b4c030b4":{"text":"Personality preset layered on top of the model - controls tone, length, and conversational stance."},"chat.info_ab41be4e36a8":{"text":"The aspect ratio of the generated image. 1:1 is square, 2:3 is portrait, 3:2 is landscape."},"chat.info_acfe9c2e8a13":{"text":"Describe what should happen in the video, including movement, expressions, pacing, and any camera changes."},"chat.info_ae6d82f8a2a3":{"text":"Outside free trials, you receive that tier\'s full monthly credit allocation immediately."},"chat.info_b046fa3aaa2f":{"text":"Describe the scene — where the kins are, what they’re doing, the mood and lighting. This sets the overall composition of the photo."},"chat.info_b21c18051877":{"text":"Set the ambient context for this conversation, such as location, attire, activity, or time."},"chat.info_b662e32e5302":{"text":"Allow explicit content in the generated video. Off by default."},"chat.info_b67153d19a67":{"text":"Available while the Autoselfie is the active proactive response."},"chat.info_b776ece90213":{"text":"A trained boost applied on top of this V5 avatar, pushing generations closer to its likeness."},"chat.info_b82e460d6959":{"text":"Cascaded memory is the running summary of older conversation. Resetting it clears that history as well as the recent messages."},"chat.info_bed2bd760fb1":{"text":"Available on the latest Kin response."},"chat.info_c0600ab8e9c8":{"text":"The kin\'s biography - origin, formative experiences, the fabric of who they are. Anchors how the model thinks about them."},"chat.info_c07fba4ed77b":{"text":"Allow this group chat to recall long-term memories from each Kindroid."},"chat.info_c46de9872457":{"text":"v4 voices consume 1.75\xd7 the credits of v2, and v3 voices 1.5\xd7. Voice previews and voice design generations also draw from the same pool."},"chat.info_c8fbfc2e285a":{"text":"This won\'t be seen by your Kindroids and is only for your reference."},"chat.info_cdb5c52ac2e3":{"text":"Create a new audio track that matches the video. This option is hidden when you add your own audio."},"chat.info_d2683d845f8c":{"text":"Available on editable messages."},"chat.info_d516b1fe9773":{"text":"Lower values keep responses more stable and predictable; higher values increase creativity and chaos. Default is 0.95."},"chat.info_d5425305fdeb":{"text":"What to change about the reply. The kin rewrites it with this in mind rather than replacing it word for word."},"chat.info_d8c441c03192":{"text":"The name shown when selecting this custom voice. It does not affect how the voice sounds."},"chat.info_db0d276bbcd5":{"text":"How much the model thinks before replying. Faster levels feel snappier; slower levels give deeper, more deliberate replies."},"chat.info_e0fd143df26f":{"text":"The avatar & description will be used in the selfies, as well as the description so your Kindroid knows what it looks like. See our user guide under selfies section for prompt tips & advanced prompting. Please note generating images based on real people whose appearances you don\'t own (e.g. anyone not you) is against our Terms."},"chat.info_e357c4b3cc1a":{"text":"Optional. Add an MP3 or WAV to set the video\'s speech, timing, and rhythm. Upload a file, or paste a Kindroid audio link or saved path and select Use."},"chat.info_e6570af5bd71":{"text":"Available on messages that can be added to favorites."},"chat.info_e7f65135ac1a":{"text":"One-time top-ups are tracked separately, do not expire monthly, and are spent only after subscription credits are used up."},"chat.info_eb1ba6a48869":{"text":"The video is animated from this uploaded image — the kin in the photo is brought to life with the motion you describe below."},"chat.info_f18d19881152":{"text":"Off uses the Call image; Standard and Premium replace it with live video when available."},"chat.info_f202ad48e454":{"text":"Enter the same seed across different selfie generations to control the randomness of the generation. Using the same seed lets you experiment with slightly different prompts in a more controlled manner."},"chat.info_f4514b668ddc":{"text":"The language model that drives this Kindroid\'s replies. Each option has a distinct personality flavor."},"chat.info_f662ae5a6c10":{"text":"Available when the Autoselfie is at the conversation tail."},"chat.info_f83227153052":{"text":"The aspect ratio of the generated selfie. 1:1 is square, 2:3 is portrait, 3:2 is landscape."},"chat.info_f951df03774c":{"text":"Routes group autoselfies through the SFW engine, which is tuned for them and less likely to refuse a group shot."},"chat.info_fa0cfd435ac0":{"text":"Automatically add clearer action, timing, camera, and audio details to your prompt before creating the video."},"chat.info_fa8d937cefb2":{"text":"Available on the active Kin response."},"chat.info_fac6b63b6f76":{"text":"How long the generated clip runs. Longer clips cost more credits and take longer to render."},"chat.info_fc800b7c09ae":{"text":"Set the scene for this conversation. Your Kindroid uses the setting as ambient context — they\'ll behave like the conversation is actually happening there."},"chat.info_fdde68955224":{"text":"Voice calls charge a per-minute base rate while connected. Live video adds an extra per-minute charge that depends on avatar tier (standard or premium)."},"chat.info_ff518e84e30e":{"text":"Fixes the random starting point so the same prompt + seed reproduces a similar result. Leave blank for a random seed each run."},"chat.internet_and_linked_reply":{"text":"Internet and linked reply"},"chat.internet_enabled":{"text":"Internet enabled"},"chat.internet_enabled_tap_to_turn_off":{"text":"Internet enabled - tap to turn off"},"chat.internet_search_turned_off":{"text":"Internet search turned off"},"chat.internet_search_will_run_on_next_message":{"text":"Internet search will run on next message"},"chat.it_ll_land_in_the_gallery_in_a_few_minutes":{"text":"It\'ll land in the gallery in a few minutes."},"chat.it_will_appear_here_when_ready":{"text":"It will appear here when ready."},"chat.job_value":{"text":"Job {{job_id}}"},"chat.journal.journal_sheet_v2_journal_sheet_v":{"text":"Journal"},"chat.journal.journal_sheet_v2_journal_sheet_v_2":{"text":"Journal"},"chat.journal.kin_settings_sheet_v2_v2_group_c":{"text":"Journal"},"chat.journal_scope":{"text":"Journal scope"},"chat.jump_to":{"text":"Jump to"},"chat.key_memories":{"text":"Key Memories"},"chat.keywords":{"text":"Keywords"},"chat.kin_message_colors":{"text":"Kin message colors"},"chat.kin_settings":{"text":"Kin settings"},"chat.kindroid_settings":{"text":"Kindroid settings"},"chat.kindroid_video_message":{"text":"Kindroid video message"},"chat.language":{"text":"Language"},"chat.last_30_days":{"text":"Last 30 days"},"chat.last_7_days":{"text":"Last 7 days"},"chat.last_90_days":{"text":"Last 90 days"},"chat.learned_context":{"text":"Learned Context"},"chat.learned_context_updated_label":{"text":" Last updated: {{relativeTime}}."},"chat.left":{"text":"Left"},"chat.legacy_custom_voice.kin_settings_sheet_v2_kin_settin":{"text":"Legacy Custom Voice"},"chat.legacy_custom_voice.kin_settings_sheet_v2_kin_settin_2":{"text":"Legacy custom voice"},"chat.legacy_predefined_avatars":{"text":"L