done_11a676":{"text":"Done"},"profile.duplicate":{"text":"Duplicate"},"profile.earn_100_selfies_75k_audio_4_slots_bf966a":{"text":"Earn 100 selfies \xb7 75k audio \xb7 4 slots"},"profile.earn_5_kin_slots_for_every_20_recreations_0cf1f4":{"text":"Earn 5 kin slots for every 20 recreations"},"profile.edit":{"text":"Edit"},"profile.email_969ccb":{"text":"Email"},"profile.email_support_about_text_messaging_904b72":{"text":"Email support about text messaging"},"profile.enter_a_3_or_6_digit_hex_code_90743f":{"text":"Enter a 3- or 6-digit hex code."},"profile.experimental_3dc9f5":{"text":"Experimental"},"profile.export_data_c16e0b":{"text":"Export data"},"profile.face_detail_enhance":{"text":"Face detail enhance"},"profile.face_details":{"text":"Face details"},"profile.feature_3d377a":{"text":"Feature"},"profile.featured_c533ca":{"text":"Featured"},"profile.for_information_questions_and_discussion_join_the_kindr_0334ff":{"text":"For information, questions, and discussion, join the Kindroid Discord server, claim the “Kin Maker Updates” role, and head to the “「\uD83D\uDDE3」kin-sharing-discussion” channel for more information and updates about the featuring process."},"profile.fragment_0c30773be2c2":{"text":"Too long"},"profile.fragment_0dfe1d63c9d8":{"text":"Checking"},"profile.fragment_290510a9fab0":{"text":"Pricing matrix"},"profile.fragment_728578938d2a":{"text":"Too short"},"profile.fragment_8fa65ffc6ed8":{"text":"Check unavailable"},"profile.fragment_aa4a8ee11418":{"text":"Get featured"},"profile.fragment_ac20a57bfde0":{"text":"Hide"},"profile.fragment_b5c120b316c2":{"text":"Saved"},"profile.fragment_c76e6790bc5b":{"text":"Taken"},"profile.fragment_e0d1b68224bf":{"text":"Current"},"profile.fragment_e674447337e8":{"text":"Available"},"profile.freckles_green_eyes":{"text":"freckles, green eyes, ..."},"profile.friend_family_co_worker":{"text":"Friend, Family, Co-worker…"},"profile.gender":{"text":"Gender"},"profile.help":{"text":"Help"},"profile.high_quality_b030ef":{"text":"High Quality"},"profile.info_03fb16d3e1fe":{"text":"Scale the app interface proportionally: Small (90%), Default (100%), Large (110%), or Extra Large (120%). This device only."},"profile.info_0eef338327ab":{"text":"Show replies word-by-word as they generate, instead of all at once."},"profile.info_113423ae3996":{"text":"Choose a core accent or create a custom color with a live chat preview. Syncs across your devices."},"profile.info_30d558a9df72":{"text":"Messages others have sent"},"profile.info_3e23d9e9b268":{"text":"Let your kindroids reference your calendar — upcoming events and availability."},"profile.info_3f2646afaa3c":{"text":"Opt in to early, experimental features before they roll out to everyone."},"profile.info_4366ff8b26f8":{"text":"Let your kins reference where you are and where you go. Kindroid only reads your location while you\'re using the app — never in the background. Set up grants the permission; Open takes you to the toggle and your list of saved places. Saving places is optional, and each kin can be given access individually from its own settings."},"profile.info_5a72ff6f7881":{"text":"Connect external tools and services, and manage API keys for programmatic access."},"profile.info_5d14e210d87d":{"text":"Choose the default bubble and text colors for Kin messages. Syncs across your devices. Individual Kin settings can override them."},"profile.info_5dec7d291d27":{"text":"Automatically play voice replies out loud as they arrive."},"profile.info_604356819be5":{"text":"Choose the bubble and text colors for your messages throughout Kindroid. Syncs across your devices."},"profile.info_69d3a6d55b13":{"text":"Set the mobile chat header and desktop avatar size on this device."},"profile.info_79e38f5387f7":{"text":"Discourages the kin from repeating the same phrases or ideas across replies."},"profile.info_8000a77df667":{"text":"How the gallery lays out media on your phone: a single-column list or a 2-up grid. This device only."},"profile.info_8117db4dda78":{"text":"Shift the entire app\'s type hierarchy lighter or bolder while preserving the contrast between body, emphasized, and heading text. This device only."},"profile.info_8405c09270ce":{"text":"Credits earned from this kin"},"profile.info_8970a2681de3":{"text":"Render the app\'s bars as floating inset cards instead of attached to the screen edges. This device only."},"profile.info_982fd4a629d8":{"text":"Choose Light, System (matches your device), or Dark mode. This device only."},"profile.info_9b2b4e1c92d0":{"text":"Request a copy of your Kindroid account data. We\'ll email a download link when it\'s ready."},"profile.info_c410994dcd6e":{"text":"Sign out every device connected to your account, including this one."},"profile.info_ddeb5154775a":{"text":"Times others have recreated this kin"},"profile.info_eb9753e176e4":{"text":"Change the email you sign in with. We\'ll send a verification code to the new address."},"profile.info_f9dbc4270f6e":{"text":"Use subtle touch feedback for important actions and controls in the mobile app. This device only."},"profile.info_fd35061ae2ec":{"text":"Show suggestive content on the Social feed. Following timeline is not affected."},"profile.invite_friends_2614b4":{"text":"Invite friends"},"profile.is_on_its_way_rewards_are_added_right_away_317860":{"text":"{{value1}} is on its way. Rewards are added right away."},"profile.issue_new_gift_code_c1bb29":{"text":"Issue New Gift Code"},"profile.issue_one_below_and_share_it_with_a_friend_7c3269":{"text":"Issue one below and share it with a friend."},"profile.issued_0221e4":{"text":"Issued"},"profile.join_discord":{"text":"Join Discord"},"profile.join_reddit":{"text":"Join Reddit"},"profile.kindroid_078cef":{"text":"Kindroid"},"profile.label":{"text":"Label"},"profile.lifetime_streak_69d6fa":{"text":"Lifetime streak: {{value1}}"},"profile.loading_daily_reward":{"text":"Loading daily reward"},"profile.loading_map_7c8bef":{"text":"Loading map…"},"profile.loading_personas":{"text":"Loa